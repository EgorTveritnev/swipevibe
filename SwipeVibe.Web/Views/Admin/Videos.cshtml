@model IEnumerable<SwipeVibe.Domain.Entities.Video.Video>
@{
    ViewBag.Title = "Управление видео";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Стили для админ-панели уже определены в Index.cshtml */
    .admin-tabs {
        margin-bottom: 30px;
    }
    
    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .admin-table th {
        text-align: left;
        padding: 15px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-dim);
        font-weight: 600;
    }
    
    .admin-table td {
        padding: 15px 10px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .admin-table tr:hover {
        background: rgba(255, 255, 255, 0.03);
    }
    
    .admin-table .text-truncate {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
    }
    
    .filter-container {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }
    
    .filter-input {
        flex: 1;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 10px 15px;
        color: var(--text-light);
        font-family: 'Montserrat', sans-serif;
    }
    
    .filter-input:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 2px rgba(255, 0, 128, 0.2);
    }
    
    .filter-button {
        background: var(--primary-gradient);
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        color: white;
        font-family: 'Montserrat', sans-serif;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .filter-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 0, 128, 0.3);
    }
    
    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }
    
    .page-item {
        margin: 0 5px;
    }
    
    .page-link {
        display: block;
        width: 35px;
        height: 35px;
        line-height: 35px;
        text-align: center;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-light);
        text-decoration: none;
        transition: all 0.3s ease;
    }
    
    .page-link:hover {
        background: rgba(255, 255, 255, 0.1);
    }
    
    .page-item.active .page-link {
        background: var(--primary-gradient);
    }
    
    .alert {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    
    .alert-success {
        background: rgba(0, 245, 160, 0.1);
        border-left: 3px solid #00F5A0;
        color: #00F5A0;
    }
    
    .alert-danger {
        background: rgba(255, 82, 82, 0.1);
        border-left: 3px solid #ff5252;
        color: #ff5252;
    }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Управление видео</h1>
        <p class="admin-subtitle">Мониторинг и модерация видеоконтента</p>
    </div>
    
    <div class="admin-tabs">
        <a href="@Url.Action("Index", "Admin")" class="admin-tab">
            <i class="fas fa-tachometer-alt"></i>
            Сводка
        </a>
        <a href="@Url.Action("Videos", "Admin")" class="admin-tab active">
            <i class="fas fa-video"></i>
            Видео
        </a>
        <a href="@Url.Action("Users", "Admin")" class="admin-tab">
            <i class="fas fa-users"></i>
            Пользователи
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    
    <div class="admin-section">
        <div class="filter-container">
            <input type="text" id="searchInput" class="filter-input" placeholder="Поиск по описанию или автору...">
            <button class="filter-button">
                <i class="fas fa-search"></i>
                Найти
            </button>
        </div>
        
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Описание</th>
                    <th>Пользователь</th>
                    <th>Дата загрузки</th>
                    <th>Лайки</th>
                    <th>Комментарии</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var video in Model)
                    {
                        <tr>
                            <td>@video.Id</td>
                            <td>
                                <span class="text-truncate" title="@video.Description">
                                    @video.Description
                                </span>
                            </td>
                            <td>@video.Username</td>
                            <td>@video.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@video.LikesCount</td>
                            <td>@video.CommentsCount</td>
                            <td>
                                <form action="@Url.Action("DeleteVideo", "Admin")" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить это видео?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@video.Id" />
                                    <button type="submit" class="video-action delete" title="Удалить видео">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            Нет загруженных видео
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div class="pagination">
            <div class="page-item active"><a href="#" class="page-link">1</a></div>
            <div class="page-item"><a href="#" class="page-link">2</a></div>
            <div class="page-item"><a href="#" class="page-link">3</a></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Поиск по таблице
        $("#searchInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $(".admin-table tbody tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
        
        // Скрытие уведомлений через 3 секунды
        setTimeout(function() {
            $(".alert").fadeOut(500);
        }, 3000);
    });
</script>
