@{
    ViewBag.Title = "Управление пользователями";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-responsive {
        overflow-x: auto;
        width: 100%;
    }

    .admin-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

    .admin-table th, .admin-table td {
        padding: 10px;
        text-align: left;
        vertical-align: middle;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .status-badge, .role-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-active {
        background: rgba(0, 245, 160, 0.15);
        color: #00F5A0;
    }

    .status-blocked {
        background: rgba(255, 82, 82, 0.15);
        color: #ff5252;
    }

    .role-user {
        background: rgba(64, 158, 255, 0.15);
        color: #409EFF;
    }

    .role-admin {
        background: rgba(255, 184, 0, 0.15);
        color: #FFB800;
    }

    .role-superadmin {
        background: rgba(156, 39, 176, 0.15);
        color: #9C27B0;
    }

    .user-actions {
        display: flex;
        gap: 6px;
    }

    .video-action {
        background: transparent;
        border: none;
        padding: 5px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        color: var(--text-light);
    }

    .video-action:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--accent-color);
    }

    @@media (max-width: 768px) {
        .admin-table {
            font-size: 12px;
        }

        .status-badge, .role-badge {
            font-size: 10px;
            padding: 4px 8px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
        }
    }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Управление пользователями</h1>
        <p class="admin-subtitle">Мониторинг и управление аккаунтами пользователей</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="admin-section">
        <div class="filter-container">
            <input type="text" id="searchInput" class="filter-input" placeholder="Поиск по имени пользователя или email...">
            <button class="filter-button">
                <i class="fas fa-search"></i> Найти
            </button>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Аватар</th>
                        <th>Имя</th>
                        <th>Email</th>
                        <th>Дата регистрации</th>
                        <th>Статус</th>
                        <th>Роль</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td><img src="@(string.IsNullOrEmpty(user.AvatarUrl) ? "/Content/Images/avatars/default.png" : user.AvatarUrl)" class="user-avatar" alt="@user.Username" /></td>
                                <td>@user.Username</td>
                                <td>@user.Email</td>
                                <td>@user.RegisteredDate.ToString("dd.MM.yyyy")</td>
                                <td><span class="status-badge @(user.IsBlocked ? "status-blocked" : "status-active")">@(user.IsBlocked ? "Заблокирован" : "Активен")</span></td>
                                <td><span class="role-badge @(user.Role == "SuperAdmin" ? "role-superadmin" : user.Role == "Admin" ? "role-admin" : "role-user")">@(user.Role == "SuperAdmin" ? "Суперадмин" : user.Role == "Admin" ? "Администратор" : "Пользователь")</span></td>
                                <td class="user-actions">
                                    @if (user.Role != "SuperAdmin")
                                    {
                                        <form action="@Url.Action("BlockUser", "Admin")" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="video-action" title="@(user.IsBlocked ? "Разблокировать" : "Заблокировать")">
                                                <i class="fas @(user.IsBlocked ? "fa-unlock" : "fa-ban")"></i>
                                            </button>
                                        </form>
                                        <form action="@Url.Action("ChangeUserRole", "Admin")" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="video-action" title="Изменить роль">
                                                <i class="fas fa-user-shield"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="video-action disabled" title="Роль суперадмина изменить нельзя" disabled>
                                            <i class="fas fa-user-secret"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Нет зарегистрированных пользователей</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $(".admin-table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        setTimeout(function () {
            $(".alert").fadeOut(500);
        }, 3000);
    });
</script>
