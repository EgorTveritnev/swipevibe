@model SwipeVibe.Web.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Панель администрирования";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Стили для админ-панели */
    .admin-container {
        padding: 20px;
    }
    
    .admin-header {
        margin-bottom: 30px;
    }
    
    .admin-title {
        font-weight: 700;
        font-size: 28px;
        margin-bottom: 10px;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .admin-subtitle {
        font-size: 16px;
        color: var(--text-dim);
    }
    
    .admin-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .admin-card {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }
    
    .admin-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    }
    
    .card-users {
        border-left: 4px solid var(--primary-color);
    }
    
    .card-videos {
        border-left: 4px solid var(--secondary-color);
    }
    
    .card-active {
        border-left: 4px solid var(--accent-color);
    }
    
    .card-blocked {
        border-left: 4px solid #ff5722;
    }
    
    .card-icon {
        font-size: 24px;
        margin-bottom: 15px;
    }
    
    .card-users .card-icon {
        color: var(--primary-color);
    }
    
    .card-videos .card-icon {
        color: var(--secondary-color);
    }
    
    .card-active .card-icon {
        color: var(--accent-color);
    }
    
    .card-blocked .card-icon {
        color: #ff5722;
    }
    
    .card-value {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 5px;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .card-videos .card-value {
        background: var(--secondary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .card-active .card-value {
        background: linear-gradient(135deg, #00D9F5, #00F5A0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .card-blocked .card-value {
        background: linear-gradient(135deg, #FF5722, #FFC107);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .card-label {
        font-size: 14px;
        color: var(--text-dim);
    }
    
    .admin-section {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .section-title {
        font-size: 20px;
        font-weight: 600;
    }
    
    .section-link {
        color: var(--primary-color);
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease;
    }
    
    .section-link:hover {
        text-decoration: underline;
    }
    
    .video-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .video-item:last-child {
        border-bottom: none;
    }
    
    .video-thumbnail {
        width: 100px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 15px;
    }
    
    .video-empty-thumbnail {
        width: 100px;
        height: 60px;
        border-radius: 8px;
        margin-right: 15px;
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1));
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .video-empty-thumbnail i {
        font-size: 24px;
        color: rgba(255, 255, 255, 0.3);
    }
    
    .video-info {
        flex: 1;
    }
    
    .video-title {
        font-weight: 500;
        margin-bottom: 5px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    
    .video-meta {
        display: flex;
        align-items: center;
        font-size: 12px;
        color: var(--text-dim);
    }
    
    .video-stats {
        display: flex;
        align-items: center;
    }
    
    .video-stat {
        display: flex;
        align-items: center;
        margin-right: 15px;
    }
    
    .video-stat i {
        margin-right: 5px;
        font-size: 14px;
    }
    
    .video-actions {
        display: flex;
    }
    
    .video-action {
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-size: 14px;
        padding: 5px;
        cursor: pointer;
        margin-left: 5px;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    
    .video-action:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-light);
    }
    
    .video-action.delete:hover {
        background: rgba(255, 0, 0, 0.2);
        color: #ff5252;
    }
    
    .admin-tabs {
        display: flex;
        margin-bottom: 20px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 10px;
        overflow: hidden;
    }
    
    .admin-tab {
        flex: 1;
        padding: 15px 20px;
        text-align: center;
        font-weight: 500;
        color: var(--text-dim);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .admin-tab.active {
        background: var(--primary-gradient);
        color: white;
    }
    
    /* Responsive admin panel */
    @@media (max-width: 768px) {
        .admin-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    
    @@media (max-width: 480px) {
        .admin-cards {
            grid-template-columns: 1fr;
        }
        
        .video-thumbnail,
        .video-empty-thumbnail {
            width: 80px;
            height: 48px;
        }
    }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1 class="admin-title">Панель администрирования</h1>
        <p class="admin-subtitle">Управление пользователями и контентом SwipeVibe</p>
    </div>
    
    <div class="admin-cards">
        <div class="admin-card card-users">
            <div class="card-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="card-value">@Model.RegisteredUsersCount</div>
            <div class="card-label">Пользователей</div>
        </div>
        
        <div class="admin-card card-videos">
            <div class="card-icon">
                <i class="fas fa-video"></i>
            </div>
            <div class="card-value">@Model.TotalVideosCount</div>
            <div class="card-label">Видео</div>
        </div>
          <div class="admin-card card-active">
            <div class="card-icon">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="card-value">@Model.ActiveUsersCount</div>
            <div class="card-label">Активных пользователей</div>
        </div>
        
        <div class="admin-card card-blocked">
            <div class="card-icon">
                <i class="fas fa-user-slash"></i>
            </div>
            <div class="card-value">@Model.BlockedUsersCount</div>
            <div class="card-label">Заблокированных</div>
        </div>
    </div>
      <div class="admin-section">
        <div style="display: flex; margin-bottom: 20px;">
            <div style="flex: 1; background: var(--card-bg); border-radius: 10px; padding: 15px; margin-right: 10px;">
                <h4 style="margin-bottom: 10px; color: var(--accent-color);">Новые пользователи сегодня</h4>
                <div style="font-size: 24px; font-weight: 700;">@Model.TodayNewUsersCount</div>
            </div>
            <div style="flex: 1; background: var(--card-bg); border-radius: 10px; padding: 15px; margin-left: 10px;">
                <h4 style="margin-bottom: 10px; color: var(--secondary-color);">Новые видео сегодня</h4>
                <div style="font-size: 24px; font-weight: 700;">@Model.TodayNewVideosCount</div>
            </div>
        </div>
        
        <div class="section-header">
            <h2 class="section-title">Последние загруженные видео</h2>
            <a href="@Url.Action("Videos", "Admin")" class="section-link">Все видео <i class="fas fa-arrow-right"></i></a>
        </div>
        
        @if (Model.LatestVideos != null && Model.LatestVideos.Any())
        {
            foreach (var video in Model.LatestVideos)
            {
                <div class="video-item">
                    @if (!string.IsNullOrEmpty(video.GradientCss))
                    {
                        <div class="video-empty-thumbnail" style="background: @video.GradientCss">
                            <i class="fas fa-play"></i>
                        </div>
                    }
                    else
                    {
                        <div class="video-empty-thumbnail">
                            <i class="fas fa-play"></i>
                        </div>
                    }
                    
                    <div class="video-info">
                        <h3 class="video-title">@video.Description</h3>
                        <div class="video-meta">
                            <span>@video.Username</span>
                            <span class="mx-2">&bull;</span>
                            <span>@(video.UploadDate.ToShortDateString())</span>
                        </div>
                    </div>
                    
                    <div class="video-stats">
                        <div class="video-stat">
                            <i class="fas fa-heart"></i>
                            <span>@video.LikesCount</span>
                        </div>
                        <div class="video-stat">
                            <i class="fas fa-comment"></i>
                            <span>@video.CommentsCount</span>
                        </div>
                    </div>
                    
                    <div class="video-actions">
                        <form action="@Url.Action("DeleteVideo", "Admin")" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить это видео?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@video.Id" />
                            <button type="submit" class="video-action delete" title="Удалить видео">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center text-muted my-4">Нет загруженных видео</p>
        }
    </div>
</div>

<script>
    $(document).ready(function() {
        // Notification for success messages
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                $('<div class="alert alert-success">')
                    .text('@TempData["SuccessMessage"]')
                    .appendTo('.admin-container')
                    .delay(3000)
                    .fadeOut(500, function() { $(this).remove(); });
            </text>
        }
        
        // Notification for error messages
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                $('<div class="alert alert-danger">')
                    .text('@TempData["ErrorMessage"]')
                    .appendTo('.admin-container')
                    .delay(3000)
                    .fadeOut(500, function() { $(this).remove(); });
            </text>
        }
    });
</script>
