@{
    ViewBag.Title = "Инструкция по восстановлению пароля отправлена";
}

<div class="auth-page">
    <div class="auth-container glass-card">
        <div class="auth-success">
            <div class="success-icon">
                <i class="fas fa-paper-plane"></i>
            </div>
            <h1 class="animated-gradient-text">Инструкция отправлена</h1>
            <p>@(ViewBag.SuccessMessage ?? "Мы отправили инструкцию по восстановлению пароля на указанный email. Проверьте свою почту, включая папку «Спам».")</p>
            
            @if (!string.IsNullOrEmpty(ViewBag.ResetUrl))
            {
                <div class="demo-reset-url">
                    <p>Это демо-версия, поэтому вместо отправки email мы показываем ссылку для сброса пароля:</p>
                    <a href="@ViewBag.ResetUrl" class="reset-link">@ViewBag.ResetUrl</a>
                </div>
            }
            
            <a href="@Url.Action("Login", "Account")" class="btn-submit">
                <span>Вернуться на страницу входа</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--background-dark);
        padding: 20px;
    }
    
    .auth-container {
        width: 100%;
        max-width: 480px;
        padding: 40px;
        border-radius: 20px;
    }
    
    .auth-success {
        text-align: center;
    }
    
    .success-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, #00F5A0, #00D9F5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: white;
        box-shadow: 0 0 30px rgba(0, 213, 255, 0.4);
        animation: pulse 2s infinite;
    }
    
    .auth-success h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 15px;
    }
    
    .auth-success p {
        color: var(--text-dim);
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 30px;
    }
    
    .demo-reset-url {
        margin: 20px 0;
        padding: 15px;
        background-color: rgba(255, 193, 7, 0.1);
        border-radius: 12px;
        text-align: left;
    }
    
    .demo-reset-url p {
        color: #FFC107;
        font-size: 14px;
        margin-bottom: 10px;
    }
    
    .reset-link {
        display: block;
        background: rgba(0, 0, 0, 0.2);
        padding: 10px;
        border-radius: 8px;
        color: #00D9F5;
        font-size: 13px;
        word-break: break-all;
        text-decoration: none;
        transition: background 0.2s ease;
    }
    
    .reset-link:hover {
        background: rgba(0, 0, 0, 0.3);
    }
    
    .btn-submit {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        background: var(--primary-gradient);
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
    }
    
    .btn-submit i {
        margin-left: 8px;
        transition: transform 0.2s ease;
    }
    
    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 15px rgba(255, 0, 128, 0.3);
    }
    
    .btn-submit:hover i {
        transform: translateX(4px);
    }
    
    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 213, 255, 0.4);
        }
        70% {
            box-shadow: 0 0 0 15px rgba(0, 213, 255, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(0, 213, 255, 0);
        }
    }

    .auth-container {
        animation: fadeSlideUp 0.6s ease forwards;
    }
    
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>