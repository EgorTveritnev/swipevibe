@model SwipeVibe.Domain.Entities.User.UserReturn
@using SwipeVibe.Domain.Entities.User
@{
    ViewBag.Title = "Профиль";
}

<div class="profile-page">
    <div class="profile-header">
        <div class="profile-cover" style="background: linear-gradient(135deg, #FF0080, #7928CA);"></div>
        <div class="profile-info">
            <div class="profile-avatar glow-effect">
                <img src="@(!string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Model.AvatarUrl : "https://i.pravatar.cc/150?img=13")" alt="User profile">
                <div class="edit-avatar">
                    <i class="fas fa-camera"></i>
                </div>
            </div>
            <div class="profile-username animated-gradient-text">@Model.Username</div>
            <div class="profile-bio-button glass-card">
                Создаю контент о путешествиях и еде 🌍🍕<br>
                Подписывайтесь на мои приключения!
            </div>
            <div class="profile-stats">
                <div class="stat-item">
                    <div class="stat-value counter" data-count="125">0</div>
                    <div class="stat-label">Подписки</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value counter" data-count="10.5">0</div>
                    <div class="stat-label">Подписчиков, K</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value counter" data-count="230">0</div>
                    <div class="stat-label">Лайков, K</div>
                </div>
            </div>
            <div class="profile-actions">
                <a href="@Url.Action("EditProfile", "Account")" class="profile-edit-btn glass-card">
                    <i class="fas fa-edit"></i> Редактировать
                </a>
                <a href="@Url.Action("EditProfile", "Account")" class="profile-settings-btn glass-card">
                    <i class="fas fa-cog"></i>
                </a>
                <button class="profile-share-btn glass-card">
                    <i class="fas fa-share-alt"></i>
                </button>
                @if (Model.Role == Role.Admin || Model.Role == Role.SuperAdmin)
                {
                    <a href="@Url.Action("Index", "Admin")" class="profile-admin-btn glass-card">
                        <i class="fas fa-shield-alt"></i> Админ-панель
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="profile-tabs glass-card">
        <div class="profile-tab active" data-tab="videos">
            <i class="fas fa-th"></i>
            <span>Видео</span>
        </div>
        <div class="profile-tab" data-tab="likes">
            <i class="fas fa-heart"></i>
            <span>Лайки</span>
        </div>
        <div class="profile-tab" data-tab="saved">
            <i class="fas fa-bookmark"></i>
            <span>Сохраненные</span>
        </div>
    </div>

    <div class="profile-content">
        <div class="tab-content active" id="videos">
            <div class="video-grid">
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?travel) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 56K</span>
                                <span><i class="fas fa-heart"></i> 5.2K</span>
                                <span><i class="fas fa-comment"></i> 342</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Путешествие в горы #travel</div>
                </div>
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?food) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 128K</span>
                                <span><i class="fas fa-heart"></i> 12.4K</span>
                                <span><i class="fas fa-comment"></i> 876</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Готовлю лучшую пасту #food</div>
                </div>
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?beach) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 45K</span>
                                <span><i class="fas fa-heart"></i> 3.7K</span>
                                <span><i class="fas fa-comment"></i> 204</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Тайская пляжная вечеринка #beach</div>
                </div>
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?city) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 92K</span>
                                <span><i class="fas fa-heart"></i> 8.3K</span>
                                <span><i class="fas fa-comment"></i> 512</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Секреты ночного города #city</div>
                </div>
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?coffee) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 78K</span>
                                <span><i class="fas fa-heart"></i> 6.1K</span>
                                <span><i class="fas fa-comment"></i> 305</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Лучшие кофейни Европы #coffee</div>
                </div>
                <div class="video-item">
                    <div class="video-item-thumbnail" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/300x500/?dance) center/cover;">
                        <div class="video-info-overlay">
                            <i class="fas fa-play play-icon"></i>
                            <div class="video-stats">
                                <span><i class="fas fa-eye"></i> 104K</span>
                                <span><i class="fas fa-heart"></i> 9.6K</span>
                                <span><i class="fas fa-comment"></i> 428</span>
                            </div>
                        </div>
                    </div>
                    <div class="video-item-text">Танцую на закате #dance</div>
                </div>
            </div>

            <div class="load-more">
                <button class="load-more-btn glass-card">
                    <i class="fas fa-spinner"></i> Загрузить больше
                </button>
            </div>
        </div>

        <div class="tab-content" id="likes">
            <div class="empty-state">
                <i class="fas fa-heart empty-icon"></i>
                <h3>Понравившиеся видео</h3>
                <p>Здесь будут отображаться видео, которые вам понравились</p>
            </div>
        </div>

        <div class="tab-content" id="saved">
            <div class="empty-state">
                <i class="fas fa-bookmark empty-icon"></i>
                <h3>Сохраненные видео</h3>
                <p>Здесь будут отображаться видео, которые вы сохранили</p>
            </div>
        </div>
    </div>

    <div class="upload-fab">
        <i class="fas fa-plus"></i>
    </div>
</div>

<style>
    .profile-page {
        background-color: var(--background-dark);
        color: var(--text-light);
        min-height: 100vh;
        padding-bottom: 70px;
        position: relative;
    }

    .profile-header {
        position: relative;
    }

    .profile-cover {
        height: 150px;
        position: relative;
        overflow: hidden;
    }

        .profile-cover:after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 50%;
            background: linear-gradient(to top, var(--background-dark), transparent);
        }

    .profile-info {
        padding: 0 20px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        margin-top: -60px;
        z-index: 2;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--background-dark);
        position: relative;
        z-index: 2;
        margin-bottom: 15px;
    }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .profile-avatar:hover img {
            transform: scale(1.05);
        }

    .edit-avatar {
        position: absolute;
        bottom: 5px;
        right: 5px;
        background: var(--accent-color);
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        z-index: 3;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .edit-avatar:hover {
            transform: scale(1.1);
        }

    .glow-effect {
        box-shadow: 0 0 20px rgba(255, 0, 128, 0.7);
    }

    .profile-username {
        font-size: 24px;
        font-weight: bold;
        margin: 5px 0 10px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    }

    .profile-bio-button {
        text-align: center;
        margin: 10px 0 15px;
        padding: 12px 20px;
        font-size: 14px;
        line-height: 1.5;
        max-width: 80%;
        border-radius: 15px;
        transition: all 0.3s ease;
    }

        .profile-bio-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

    .profile-stats {
        display: flex;
        justify-content: space-around;
        width: 100%;
        margin: 15px 0;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.3s ease;
    }

        .stat-item:hover {
            transform: translateY(-5px);
        }

    .stat-value {
        font-size: 22px;
        font-weight: bold;
        background: linear-gradient(45deg, #FF0080, #7928CA);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-dim);
    }

    .profile-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .profile-edit-btn, .profile-settings-btn, .profile-share-btn {
        background: transparent;
        border: none;
        padding: 10px 15px;
        border-radius: 25px;
        font-size: 14px;
        color: var(--text-light);
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
    }

    .profile-settings-btn, .profile-share-btn {
        width: 40px;
        height: 40px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .profile-edit-btn i {
        margin-right: 5px;
    }

    .profile-edit-btn:hover, .profile-settings-btn:hover, .profile-share-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .profile-admin-btn {
        background: linear-gradient(45deg, #FF0080, #7928CA);
        border: none;
        padding: 10px 15px;
        border-radius: 25px;
        font-size: 14px;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
        margin-left: 10px;
        font-weight: 500;
        text-decoration: none;
    }

        .profile-admin-btn i {
            margin-right: 5px;
        }

        .profile-admin-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 0, 128, 0.4);
            text-decoration: none;
            color: white;
        }

    .profile-tabs {
        display: flex;
        justify-content: space-around;
        margin: 0 15px 20px;
        padding: 5px;
        border-radius: 15px;
    }

    .profile-tab {
        padding: 15px 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-dim);
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .profile-tab.active {
            color: var(--accent-color);
            font-weight: 500;
        }

            .profile-tab.active:before {
                content: "";
                position: absolute;
                bottom: 0;
                left: 25%;
                width: 50%;
                height: 3px;
                background: var(--primary-gradient);
                border-radius: 3px;
            }

        .profile-tab i {
            font-size: 18px;
            margin-bottom: 5px;
        }

        .profile-tab span {
            font-size: 14px;
        }

    .profile-content {
        padding: 10px 15px;
    }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .video-item {
        position: relative;
        margin-bottom: 10px;
        transition: transform 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
    }

        .video-item:hover {
            transform: translateY(-5px);
        }

    .video-item-thumbnail {
        position: relative;
        padding-top: 177%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .video-info-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, transparent 60%, rgba(0, 0, 0, 0.8));
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 15px 10px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .video-item:hover .video-info-overlay {
        opacity: 1;
    }

    .play-icon {
        font-size: 40px;
        color: white;
        align-self: center;
        margin-top: 30%;
        filter: drop-shadow(0 0 5px rgba(0, 0, 0, 0.5));
        transition: transform 0.3s ease;
    }

    .video-item:hover .play-icon {
        transform: scale(1.2);
    }

    .video-stats {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: white;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
    }

        .video-stats span {
            margin-right: 8px;
        }

        .video-stats i {
            margin-right: 3px;
        }

    .video-item-text {
        margin-top: 8px;
        font-size: 14px;
        line-height: 1.4;
        font-weight: 500;
        padding: 0 5px;
    }

    .load-more {
        margin-top: 25px;
        text-align: center;
    }

    .load-more-btn {
        padding: 12px 30px;
        border: none;
        border-radius: 25px;
        background: transparent;
        color: var(--text-light);
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .load-more-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .load-more-btn i {
            margin-right: 8px;
        }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 300px;
        text-align: center;
        padding: 20px;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 20px;
        opacity: 0.7;
        color: var(--text-dim);
    }

    .empty-state h3 {
        margin: 0 0 10px;
        font-size: 18px;
        color: var(--text-light);
    }

    .empty-state p {
        margin: 0;
        font-size: 14px;
        color: var(--text-dim);
        max-width: 250px;
    }

    .upload-fab {
        position: fixed;
        bottom: 80px;
        right: 20px;
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: var(--primary-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        box-shadow: 0 5px 15px rgba(255, 0, 128, 0.4);
        z-index: 10;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .upload-fab:hover {
            transform: translateY(-5px) rotate(90deg);
            box-shadow: 0 8px 25px rgba(255, 0, 128, 0.6);
        }
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section scripts {
    <script>
        $(document).ready(function() {
            $('.profile-tab').click(function() {
                const tabId = $(this).data('tab');

                $('.profile-tab').removeClass('active');
                $(this).addClass('active');

                $('.tab-content').removeClass('active');
                $('#' + tabId).addClass('active');
            });

            setTimeout(function() {
                $('.counter').each(function() {
                    const $this = $(this);
                    const countTo = parseFloat($this.attr('data-count'));
                    const isDecimal = countTo % 1 !== 0;

                    $({ countNum: 0 }).animate({
                        countNum: countTo
                    }, {
                        duration: 1500,
                        easing: 'swing',
                        step: function() {
                            if(isDecimal) {
                                $this.text(this.countNum.toFixed(1));
                            } else {
                                $this.text(Math.floor(this.countNum));
                            }
                        },
                        complete: function() {
                            if(isDecimal) {
                                $this.text(countTo.toFixed(1));
                            } else {
                                $this.text(Math.floor(countTo));
                            }
                        }
                    });
                });
            }, 500);

            $('.video-item').click(function() {
                window.location.href = '@Url.Action("Index", "Home")';
            });

            $('.load-more-btn').click(function() {
                $(this).html('<i class="fas fa-spinner fa-spin"></i> Загрузка...');

                setTimeout(function() {
                    $('.load-more-btn').html('<i class="fas fa-check"></i> Загружено');

                    setTimeout(function() {
                        $('.load-more-btn').html('<i class="fas fa-spinner"></i> Загрузить больше');
                    }, 2000);
                }, 1500);
            });

            $('.upload-fab').click(function() {
                alert('Функция загрузки видео будет доступна в следующей версии');
            });

            $(window).scroll(function() {
                const scrollTop = $(this).scrollTop();
                if (scrollTop < 200) {
                    $('.profile-cover').css('transform', 'translateY(' + (scrollTop * 0.3) + 'px)');
                }
            });
        });
    </script>
}