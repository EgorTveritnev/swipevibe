@model SwipeVibe.Web.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Восстановление пароля";
}

<div class="auth-page">
    <div class="auth-container glass-card">
        <div class="auth-header">
            <h1 class="animated-gradient-text">Восстановление пароля</h1>
            <p>Введите ваш email для получения ссылки на сброс пароля</p>
        </div>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation-error" })
            </div>

            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

            <button type="submit" class="btn-submit">
                <span>Отправить инструкцию</span>
                <i class="fas fa-paper-plane"></i>
            </button>
            
            <div class="auth-links">
                <a href="@Url.Action("Login", "Account")">Вернуться на страницу входа</a>
            </div>
        }
        
        <div class="auth-tip">
            <i class="fas fa-info-circle"></i>
            <p>На ваш email будет отправлена ссылка для сброса пароля. Проверьте также папку "Спам", если письмо не пришло в течение нескольких минут.</p>
        </div>
    </div>
</div>

<style>
    /* Используем те же стили, что и для других страниц */
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--background-dark);
        padding: 20px;
    }
    
    .auth-container {
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 20px;
    }
    
    .auth-header {
        text-align: center;
        margin-bottom: 25px;
    }
    
    .auth-header h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 10px;
    }
    
    .auth-header p {
        color: var(--text-dim);
        font-size: 16px;
    }
    
    .auth-form {
        margin-bottom: 20px;
    }
    
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
    }
    
    .form-control {
        width: 100%;
        padding: 12px 15px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: var(--text-light);
        font-size: 15px;
        transition: all 0.3s ease;
    }
    
    .form-control:focus {
        outline: none;
        border-color: var(--accent-color);
        box-shadow: 0 0 0 2px rgba(255, 0, 128, 0.25);
    }
    
    .validation-error {
        color: #ff4d4d;
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }
    
    .validation-summary {
        color: #ff4d4d;
        margin-bottom: 15px;
        padding: 10px;
        background-color: rgba(255, 77, 77, 0.1);
        border-radius: 8px;
        font-size: 14px;
    }
    
    .btn-submit {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        background: var(--primary-gradient);
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .btn-submit i {
        margin-left: 8px;
        transition: transform 0.2s ease;
    }
    
    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 15px rgba(255, 0, 128, 0.3);
    }
    
    .btn-submit:hover i {
        transform: translateX(4px);
    }
    
    .auth-links {
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
    }
    
    .auth-links a {
        color: var(--text-dim);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    
    .auth-links a:hover {
        color: var(--text-light);
    }
    
    .auth-tip {
        margin-top: 30px;
        padding: 15px;
        background-color: rgba(0, 213, 255, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: flex-start;
    }
    
    .auth-tip i {
        color: #00D5FF;
        font-size: 20px;
        margin-right: 12px;
        margin-top: 2px;
    }
    
    .auth-tip p {
        color: var(--text-dim);
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
    }
    
    /* Анимации */
    .auth-container {
        animation: fadeSlideUp 0.6s ease forwards;
    }
    
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    
    <script>
        $(document).ready(function() {
            // Анимация для полей формы при фокусе
            $('.form-control').focus(function() {
                $(this).parent().addClass('focused');
            }).blur(function() {
                if (!$(this).val()) {
                    $(this).parent().removeClass('focused');
                }
            });
            
            // Проверка, если в полях есть значения при загрузке
            $('.form-control').each(function() {
                if ($(this).val()) {
                    $(this).parent().addClass('focused');
                }
            });
        });
    </script>
}