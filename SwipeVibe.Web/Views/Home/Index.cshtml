<style>
    .swipe-container {
        width: 100%;
        height: 100vh;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
    }

    .video-container {
        position: relative;
        width: 100%;
        height: calc(100vh - 60px); /* Высота минус нижнее меню */
        scroll-snap-align: start;
        overflow: hidden;
    }

    .video-placeholder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
        transition: transform 0.3s ease, filter 0.3s ease;
    }
    
    .video-placeholder:before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(2px);
        z-index: -1;
    }

    .video-placeholder i {
        font-size: 80px;
        color: rgba(255, 255, 255, 0.8);
        filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.6));
        transition: transform 0.3s ease;
    }
    
    .video-placeholder:hover i {
        transform: scale(1.1);
    }

    .video-info {
        position: absolute;
        bottom: 100px;
        left: 15px;
        z-index: 2;
        max-width: 70%;
        animation: slideUp 0.5s ease;
    }

    .user-info {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .user-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        overflow: hidden;
        margin-right: 10px;
        border: 3px solid #FF0080;
        position: relative;
    }
    
    .glow-effect {
        box-shadow: 0 0 15px rgba(255, 0, 128, 0.7);
        animation: pulse 2s infinite;
    }

    .user-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    
    .user-avatar:hover img {
        transform: scale(1.1);
    }

    .username {
        font-weight: bold;
        font-size: 18px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
    }
    
    .verified-badge {
        font-size: 14px;
        color: #00D9F5;
        margin-left: 5px;
        animation: pulse 2s infinite;
    }

    .video-description {
        font-size: 16px;
        margin-bottom: 5px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        line-height: 1.4;
    }
    
    .hashtag {
        color: #00D9F5;
        font-weight: 500;
    }

    .video-actions {
        position: absolute;
        right: 15px;
        bottom: 100px;
        display: flex;
        flex-direction: column;
        z-index: 2;
        animation: slideIn 0.5s ease;
    }

    .action-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .action-icon-wrapper {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 5px;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .action-icon-wrapper:hover {
        transform: scale(1.1);
    }
    
    .heart-icon:hover {
        background: rgba(255, 0, 128, 0.3);
    }
    
    .comment-icon:hover {
        background: rgba(0, 217, 245, 0.3);
    }
    
    .share-icon:hover {
        background: rgba(255, 138, 0, 0.3);
    }
    
    .bookmark-icon:hover {
        background: rgba(0, 245, 160, 0.3);
    }

    .action-item i {
        font-size: 22px;
        color: #fff;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        transition: all 0.3s ease;
    }

    .action-item span {
        font-size: 13px;
        color: #fff;
        font-weight: 500;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }
    
    .music-disc {
        position: absolute;
        bottom: -80px;
        right: 15px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(45deg, #FF0080, #7928CA);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: floatUpDown 3s ease infinite;
        box-shadow: 0 0 15px rgba(255, 0, 128, 0.5);
    }
    
    .rotating {
        animation: rotate 4s linear infinite, floatUpDown 3s ease infinite;
    }
    
    .music-disc i {
        font-size: 18px;
        color: white;
    }
    
    .progress-bar {
        position: absolute;
        bottom: 80px;
        left: 0;
        width: 100%;
        height: 3px;
        background: rgba(255, 255, 255, 0.2);
    }
    
    .progress {
        width: 40%;
        height: 100%;
        background: linear-gradient(90deg, #FF0080, #7928CA);
    }

    /* Скрыть полосу прокрутки для лучшего UI */
    .swipe-container::-webkit-scrollbar {
        display: none;
    }
    .swipe-container {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    
    /* Анимации */
    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 0, 128, 0.7);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(255, 0, 128, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(255, 0, 128, 0);
        }
    }
    
    @@keyframes slideIn {
        0% {
            transform: translateX(20px);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @@keyframes slideUp {
        0% {
            transform: translateY(20px);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    @@keyframes floatUpDown {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    
    @@keyframes rotate {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>

@section scripts {
<script>
    $(document).ready(function() {
        // Обработчик для плавного скролла между видео
        $('#swipeContainer').on('wheel', function(e) {
            e.preventDefault();
            
            const videoHeight = $('.video-container').height();
            const currentScroll = $(this).scrollTop();
            let scrollToPosition;
            
            if (e.originalEvent.deltaY > 0) {
                // Скролл вниз
                scrollToPosition = Math.ceil(currentScroll / videoHeight) * videoHeight;
            } else {
                // Скролл вверх
                scrollToPosition = Math.floor(currentScroll / videoHeight - 0.5) * videoHeight;
            }
            
            $(this).animate({
                scrollTop: scrollToPosition
            }, 300);
        });
        
        // Имитация нажатия на лайки
        $('.heart-icon').on('click', function() {
            const icon = $(this).find('i');
            const count = $(this).parent().find('span');
            
            if (icon.hasClass('liked')) {
                icon.removeClass('liked');
                icon.css('color', '#fff');
                count.text((parseInt(count.text().replace(/\D/g,'')) - 1) + 'K');
                $(this).css('background', 'rgba(255, 255, 255, 0.1)');
            } else {
                icon.addClass('liked');
                icon.css('color', '#FF0080');
                count.text((parseInt(count.text().replace(/\D/g,'')) + 1) + 'K');
                $(this).css('background', 'rgba(255, 0, 128, 0.3)');
                
                // Эффект сердечек при лайке
                createHeartEffect($(this));
            }
        });
        
        // Эффект для закладок
        $('.bookmark-icon').on('click', function() {
            const icon = $(this).find('i');
            
            if (icon.hasClass('bookmarked')) {
                icon.removeClass('bookmarked');
                icon.css('color', '#fff');
                $(this).css('background', 'rgba(255, 255, 255, 0.1)');
            } else {
                icon.addClass('bookmarked');
                icon.css('color', '#00F5A0');
                $(this).css('background', 'rgba(0, 245, 160, 0.3)');
            }
        });
        
        // Функция для создания эффекта сердечек
        function createHeartEffect(element) {
            for (let i = 0; i < 5; i++) {
                const heart = $('<i class="fas fa-heart temp-heart"></i>');
                const size = Math.random() * 15 + 10;
                const posX = Math.random() * 40 - 20;
                const delay = Math.random() * 0.5;
                
                heart.css({
                    'position': 'absolute',
                    'color': '#FF0080',
                    'font-size': size + 'px',
                    'left': '50%',
                    'top': '50%',
                    'transform': 'translate(-50%, -50%)',
                    'opacity': 0.9,
                    'transition': 'all 1s ease',
                    'z-index': 1000
                });
                
                element.append(heart);
                
                setTimeout(function() {
                    heart.css({
                        'transform': 'translate(' + posX + 'px, -50px)',
                        'opacity': 0
                    });
                    
                    setTimeout(function() {
                        heart.remove();
                    }, 1000);
                }, delay * 1000);
            }
        }
        
        // Определение текущего видео при скролле
        $('#swipeContainer').on('scroll', function() {
            const scrollTop = $(this).scrollTop();
            const videoHeight = $('.video-container').height();
            const currentIndex = Math.round(scrollTop / videoHeight);
            
            $('.video-container').each(function(index) {
                if (index === currentIndex) {
                    $(this).find('.video-info, .video-actions').css('opacity', 1);
                } else {
                    $(this).find('.video-info, .video-actions').css('opacity', 0.3);
                }
            });
        });
        
        // Инициализация для первого видео
        $('.video-container').first().find('.video-info, .video-actions').css('opacity', 1);
    });
</script>
}