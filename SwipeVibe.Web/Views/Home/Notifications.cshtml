@{
    ViewBag.Title = "Уведомления";
}

<div class="notifications-page">
    <div class="page-header">
        <h1 class="animated-gradient-text">Уведомления</h1>
    </div>
    
    <div class="notifications-tabs">
        <div class="tab active">Все</div>
        <div class="tab">Лайки</div>
        <div class="tab">Комментарии</div>
        <div class="tab">Упоминания</div>
        <div class="tab">Подписки</div>
    </div>
    
    <div class="notifications-list">
        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar glow-effect">
                    <img src="https://i.pravatar.cc/150?img=5" alt="User avatar">
                </div>
                <div class="notification-type like-type">
                    <i class="fas fa-heart"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>@@musicfan</strong> поставил(а) лайк вашему видео
                </div>
                <div class="notification-time">2 часа назад</div>
            </div>
            <div class="notification-action">
                <div class="notification-video">
                    <div class="video-mini" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/60x80/?dance) center/cover;">
                        <div class="play-icon-mini">
                            <i class="fas fa-play"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar glow-effect" style="border-color: #00D9F5;">
                    <img src="https://i.pravatar.cc/150?img=4" alt="User avatar">
                </div>
                <div class="notification-type comment-type">
                    <i class="fas fa-comment"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>@@trendsetter</strong> оставил(а) комментарий: "Это потрясающе! 🔥"
                </div>
                <div class="notification-time">5 часов назад</div>
            </div>
            <div class="notification-action">
                <div class="notification-video">
                    <div class="video-mini" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/60x80/?sport) center/cover;">
                        <div class="play-icon-mini">
                            <i class="fas fa-play"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar glow-effect" style="border-color: #00F5A0;">
                    <img src="https://i.pravatar.cc/150?img=6" alt="User avatar">
                </div>
                <div class="notification-type follow-type">
                    <i class="fas fa-user-plus"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>@@creativeperson</strong> подписался(ась) на вас
                </div>
                <div class="notification-time">1 день назад</div>
            </div>
            <div class="notification-action">
                <div class="notification-follow-btn">
                    Подписаться
                </div>
            </div>
        </div>
        
        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar multiple-avatars">
                    <img src="https://i.pravatar.cc/150?img=8" alt="User avatar">
                    <div class="more-users">+3</div>
                </div>
                <div class="notification-type like-type">
                    <i class="fas fa-heart"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>@@dancefan</strong> и ещё 3 человека поставили лайк вашему видео
                </div>
                <div class="notification-time">1 день назад</div>
            </div>
            <div class="notification-action">
                <div class="notification-video">
                    <div class="video-mini" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/60x80/?music) center/cover;">
                        <div class="play-icon-mini">
                            <i class="fas fa-play"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar glow-effect" style="border-color: #FF8A00;">
                    <img src="https://i.pravatar.cc/150?img=9" alt="User avatar">
                </div>
                <div class="notification-type mention-type">
                    <i class="fas fa-at"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>@@videocreator</strong> упомянул(а) вас в комментарии: "Эй, @@myusername, что думаешь?"
                </div>
                <div class="notification-time">2 дня назад</div>
            </div>
            <div class="notification-action">
                <div class="notification-video">
                    <div class="video-mini" style="background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1)), url(https://source.unsplash.com/random/60x80/?city) center/cover;">
                        <div class="play-icon-mini">
                            <i class="fas fa-play"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="notification-item glass-card">
            <div class="notification-left">
                <div class="notification-avatar system-avatar">
                    <i class="fas fa-award"></i>
                </div>
                <div class="notification-type system-type">
                    <i class="fas fa-bell"></i>
                </div>
            </div>
            <div class="notification-content">
                <div class="notification-text">
                    <strong>Поздравляем!</strong> Ваше видео набрало более 100K просмотров!
                </div>
                <div class="notification-time">3 дня назад</div>
            </div>
            <div class="notification-action">
                <button class="notification-celebrate-btn">
                    <i class="fas fa-party-horn"></i> Отметить
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .notifications-page {
        padding: 15px 15px 70px;
        background-color: var(--background-dark);
        min-height: 100vh;
    }
    
    .page-header {
        margin-bottom: 20px;
        text-align: center;
    }
    
    .page-header h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        padding: 0;
    }
    
    .notifications-tabs {
        display: flex;
        overflow-x: auto;
        margin-bottom: 20px;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    
    .notifications-tabs::-webkit-scrollbar {
        display: none;
    }
    
    .tab {
        padding: 10px 20px;
        margin-right: 10px;
        white-space: nowrap;
        font-size: 14px;
        color: var(--text-dim);
        border-bottom: 2px solid transparent;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .tab.active {
        color: var(--text-light);
        border-bottom: 2px solid var(--accent-color);
        font-weight: 500;
    }
    
    .tab:hover:not(.active) {
        color: var(--text-light);
        border-bottom-color: rgba(255, 0, 128, 0.3);
    }
    
    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    
    .notification-item {
        display: flex;
        align-items: center;
        padding: 15px;
        border-radius: 15px;
        position: relative;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .notification-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }
    
    .notification-left {
        position: relative;
        margin-right: 15px;
    }
    
    .notification-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--accent-color);
        position: relative;
    }
    
    .notification-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .glow-effect {
        box-shadow: 0 0 10px rgba(255, 0, 128, 0.5);
    }
    
    .multiple-avatars {
        background-color: #333;
        border-color: #FF0080;
        box-shadow: 0 0 10px rgba(255, 0, 128, 0.5);
    }
    
    .system-avatar {
        background: linear-gradient(135deg, #FFD700, #FFA500);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 22px;
        border-color: #FFA500;
        box-shadow: 0 0 10px rgba(255, 165, 0, 0.5);
    }
    
    .more-users {
        position: absolute;
        right: 0;
        bottom: 0;
        background-color: var(--accent-color);
        color: white;
        font-size: 10px;
        padding: 2px 4px;
        border-radius: 10px;
    }
    
    .notification-type {
        position: absolute;
        bottom: -5px;
        right: -5px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: white;
        border: 2px solid var(--background-dark);
    }
    
    .like-type {
        background: linear-gradient(135deg, #FF0080, #7928CA);
    }
    
    .comment-type {
        background: linear-gradient(135deg, #00D9F5, #00F5A0);
    }
    
    .follow-type {
        background: linear-gradient(135deg, #00F5A0, #00D9F5);
    }
    
    .mention-type {
        background: linear-gradient(135deg, #FF8A00, #FF0080);
    }
    
    .system-type {
        background: linear-gradient(135deg, #FFD700, #FFA500);
    }
    
    .notification-content {
        flex: 1;
        min-width: 0;
    }
    
    .notification-text {
        font-size: 14px;
        margin-bottom: 4px;
        line-height: 1.4;
    }
    
    .notification-text strong {
        color: var(--text-light);
    }
    
    .notification-time {
        font-size: 12px;
        color: var(--text-dim);
    }
    
    .notification-action {
        margin-left: 10px;
    }
    
    .notification-video {
        width: 60px;
        height: 80px;
    }
    
    .video-mini {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease;
    }
    
    .video-mini:hover {
        transform: scale(1.05);
    }
    
    .play-icon-mini {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 20px;
        height: 20px;
        background: rgba(255, 0, 128, 0.8);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
    }
    
    .notification-follow-btn, .notification-celebrate-btn {
        padding: 8px 15px;
        background: linear-gradient(135deg, #00F5A0, #00D9F5);
        border: none;
        border-radius: 20px;
        color: white;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }
    
    .notification-follow-btn:hover {
        background: linear-gradient(135deg, #00D9F5, #00F5A0);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 217, 245, 0.3);
    }
    
    .notification-celebrate-btn {
        background: linear-gradient(135deg, #FFD700, #FFA500);
    }
    
    .notification-celebrate-btn:hover {
        background: linear-gradient(135deg, #FFA500, #FFD700);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 165, 0, 0.3);
    }

    .notification-item {
        animation: slideIn 0.5s ease forwards;
        opacity: 0;
        transform: translateX(-20px);
    }
    
    .notification-item:nth-child(1) { animation-delay: 0.1s; }
    .notification-item:nth-child(2) { animation-delay: 0.2s; }
    .notification-item:nth-child(3) { animation-delay: 0.3s; }
    .notification-item:nth-child(4) { animation-delay: 0.4s; }
    .notification-item:nth-child(5) { animation-delay: 0.5s; }
    .notification-item:nth-child(6) { animation-delay: 0.6s; }
    
    @@keyframes slideIn {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>

@section scripts {
    <script>
        $(document).ready(function() {
            $('.tab').click(function() {
                $('.tab').removeClass('active');
                $(this).addClass('active');               
                const tabType = $(this).text().toLowerCase();
                if(tabType === "все") {
                    $('.notification-item').fadeIn(300);
                } else {
                    $('.notification-item').hide();
                    switch(tabType) {
                        case "лайки":
                            $('.notification-item .like-type').parent().parent().fadeIn(300);
                            break;
                        case "комментарии":
                            $('.notification-item .comment-type').parent().parent().fadeIn(300);
                            break;
                        case "упоминания":
                            $('.notification-item .mention-type').parent().parent().fadeIn(300);
                            break;
                        case "подписки":
                            $('.notification-item .follow-type').parent().parent().fadeIn(300);
                            break;
                    }
                }
                
                $('.notifications-list').css('opacity', '0.5');
                setTimeout(function() {
                    $('.notifications-list').css('opacity', '1');
                }, 300);
            });
            
            $('.notification-video').click(function() {
                window.location.href = '@Url.Action("Index", "Home")';
            });
            
            $('.notification-follow-btn').click(function() {
                if($(this).text() === 'Подписаться') {
                    $(this).text('Подписки');
                    $(this).css('background', 'linear-gradient(135deg, #333, #555)');
                } else {
                    $(this).text('Подписаться');
                    $(this).css('background', 'linear-gradient(135deg, #00F5A0, #00D9F5)');
                }
            });

            $('.notification-celebrate-btn').click(function() {
                $(this).html('<i class="fas fa-check"></i> Отмечено');
                $(this).css('background', 'linear-gradient(135deg, #333, #555)');                
                createConfetti();
            });
            
            function createConfetti() {
                for (let i = 0; i < 50; i++) {
                    const confetti = $('<div class="confetti"></div>');
                    const colors = ['#FF0080', '#7928CA', '#00F5A0', '#00D9F5', '#FF8A00'];
                    const color = colors[Math.floor(Math.random() * colors.length)];
                    const size = Math.random() * 10 + 5;
                    const left = Math.random() * 100;
                    
                    confetti.css({
                        'position': 'fixed',
                        'width': size + 'px',
                        'height': size + 'px',
                        'background-color': color,
                        'top': '-10px',
                        'left': left + '%',
                        'z-index': 9999,
                        'border-radius': '50%',
                        'opacity': Math.random() + 0.5
                    });
                    
                    $('body').append(confetti);                   
                    const animationDuration = Math.random() * 3 + 2;
                    const fallDistance = Math.random() * 300 + 200;
                    
                    confetti.animate({
                        top: '+=' + fallDistance + 'px',
                        left: '+=' + (Math.random() * 40 - 20) + 'px'
                    }, {
                        duration: animationDuration * 1000,
                        easing: 'linear',
                        complete: function() {
                            $(this).fadeOut(500, function() {
                                $(this).remove();
                            });
                        }
                    });
                }
            }
        });
    </script>
}